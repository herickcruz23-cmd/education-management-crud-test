# API Configuration
VITE_API_URL=http://localhost:5007

# Application Configuration
VITE_APP_NAME=Education Management System
VITE_APP_VERSION=1.0.0

# Environment
NODE_ENV=development

# Blockchain certificate verification (Problem 3)
# Deploy contracts/CertificateVerification.sol (see contracts/scripts/deploy.js)
# and paste the resulting address below.
VITE_CERTIFICATE_CONTRACT_ADDRESS=

# Optional: web3.storage API token for real IPFS uploads.
# Without it, certificate metadata falls back to a local placeholder hash
# (clearly labeled in the UI) so the on-chain flow can still be demoed.
VITE_WEB3_STORAGE_TOKEN=
